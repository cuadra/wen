{
  "manifest_version": 3,
  "name": "AEM Model JSON Checker",
  "version": "1.0.0",
  "description": "Instantly checks if a .model.json exists for the current page and displays a human-readable lastModifiedDate.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Check .model.json"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
